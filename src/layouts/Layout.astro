---
import '../styles/global.css';
import { links } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dusty — trusted home cleaning, matched to you',
  description = 'Dusty connects busy UK households with vetted, local cleaners. Tell us what you need and our AI finds the right cleaner for you.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dusty" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
    <!--
      Visit counting, shown on Dusty's own dashboard. No cookies and nothing
      saved on the visitor's device; Dusty's server doesn't keep IP addresses
      (see the privacy policy). Respects "Do Not Track".
    -->
    <script is:inline define:vars={{ customer: links.customerWaitlist, cleaner: links.cleanerSignup }}>
      (function () {
        var API = 'https://dusty-api.fly.dev/w';
        if (navigator.doNotTrack === '1' || /^(localhost|127\.0\.0\.1)$/.test(location.hostname)) return;
        function send(k) {
          try {
            var utm = new URLSearchParams(location.search).get('utm_source');
            var body = JSON.stringify({ k: k, p: location.pathname, r: document.referrer || undefined, u: utm || undefined });
            if (navigator.sendBeacon) navigator.sendBeacon(API, body);
            else fetch(API, { method: 'POST', body: body, keepalive: true, mode: 'no-cors' });
          } catch (e) {}
        }
        send('view');
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a) return;
          var h = a.href;
          var k = /apps\.apple\.com/.test(h) ? 'app_store'
            : /play\.google\.com/.test(h) ? 'google_play'
            : /wa\.me|whatsapp\.com/.test(h) ? 'whatsapp'
            : /instagram\.com/.test(h) ? 'instagram'
            : h === customer ? 'waitlist_link'
            : h === cleaner ? 'cleaner_signup'
            : null;
          if (k) send(k);
        });
        document.addEventListener('submit', function (e) {
          if (e.target && e.target.id === 'early-access-form') send('waitlist_form');
        });
      })();
    </script>
  </body>
</html>
