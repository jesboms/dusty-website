---
import '../styles/global.css';
import { organizationJsonLd } from '../data/structuredData';

interface Props {
  title?: string;
  description?: string;
  /** Structured data (schema.org objects) for this page, on top of the Organization block every page gets. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title = 'Dusty — trusted home cleaning, matched to you',
  description = 'Dusty connects busy UK households with vetted, local cleaners. Tell us what you need and our AI finds the right cleaner for you.',
  jsonLd = [],
} = Astro.props;

// `</` can't appear inside a <script> block, so escape it in the JSON.
const structuredData = [organizationJsonLd, ...jsonLd].map((d) => JSON.stringify(d).replace(/<\//g, '<\\/'));

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dusty" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {structuredData.map((json) => <script type="application/ld+json" is:inline set:html={json} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
