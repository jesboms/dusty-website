          <div>
            <h3 class="font-bold text-sm uppercase tracking-wider text-gray-400 mb-5">Contact Us</h3>
            <div class="space-y-3">
              <a href={`mailto:${contact.email}`} class="flex items-center gap-2.5 text-gray-400 hover:text-white transition-colors duration-200">
                <Mail size={16} />
