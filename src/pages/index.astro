</Layout>

<script>
  // Mobile menu
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.menu-open')!.classList.toggle('hidden', open);
    toggle.querySelector('.menu-close')!.classList.toggle('hidden', !open);
  };
  toggle.addEventListener('click', () => setMenu(menu.hidden));
  document.querySelectorAll('[data-scroll]').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  // Hero carousel: crossfade, advancing every 5s
  const carousel = document.getElementById('hero-carousel')!;
  const slides = [...carousel.querySelectorAll<HTMLElement>('[data-slide]')];
  const dots = [...carousel.querySelectorAll<HTMLElement>('[data-dot]')];
  let current = 0;

  const show = (idx: number) => {
    current = (idx + slides.length) % slides.length;
    slides.forEach((s, i) => (s.style.opacity = i === current ? '1' : '0'));
    dots.forEach((d, i) => {
      d.classList.toggle('bg-white', i === current);
      d.classList.toggle('scale-125', i === current);
      d.classList.toggle('bg-white/50', i !== current);
      d.classList.toggle('hover:bg-white/75', i !== current);
    });
  };

  carousel.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
  carousel.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));
  dots.forEach((d, i) => d.addEventListener('click', () => show(i)));

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setInterval(() => show(current + 1), 5000);
  }

  // Early access form: opens under its button, and is open already when the
  // page is visited via #early-access
  const eaToggle = document.getElementById('early-access-toggle')!;
  const eaPanel = document.getElementById('early-access-panel')!;
  const eaForm = document.getElementById('early-access-form') as HTMLFormElement;
  const eaDone = document.getElementById('early-access-done')!;
  const eaError = eaForm.querySelector<HTMLElement>('[data-error]')!;
  const setPanel = (open: boolean) => {
    eaPanel.hidden = !open;
    eaToggle.setAttribute('aria-expanded', String(open));
  };
  eaToggle.addEventListener('click', () => {
    setPanel(eaPanel.hidden);
    if (!eaPanel.hidden) eaForm.querySelector('input')?.focus();
  });
  if (location.hash === '#early-access') setPanel(true);

  // Google Forms sends no CORS headers, so the response can't be read; a
  // request that completes without a network error counts as sent.
  eaForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submit = eaForm.querySelector<HTMLButtonElement>('[type=submit]')!;
    submit.disabled = true;
    eaError.hidden = true;
    try {
      await fetch(eaForm.action, { method: 'POST', mode: 'no-cors', body: new FormData(eaForm) });
      eaForm.hidden = true;
      eaDone.hidden = false;
      eaDone.focus();
    } catch {
      eaError.hidden = false;
      submit.disabled = false;
    }
  });
</script>
