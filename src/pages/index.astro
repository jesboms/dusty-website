---
import Layout from '../layouts/Layout.astro';
import { links, contact, stats } from '../data/site';

const appLive = Boolean(links.appStore || links.googlePlay);

const steps = [
  { title: 'Tell us what you need', body: 'Your home, your dates, your budget. Takes a minute.' },
  { title: 'Get matched', body: 'Dusty suggests the cleaner who fits best — and tells you why.' },
  { title: 'Pick your time', body: 'One-off, regular or a deep clean. Whatever suits you.' },
  { title: 'Enjoy a clean home', body: 'Relax. Your card is only charged once the job is done.' },
];

const reasons = [
  {
    title: 'Vetted, trusted cleaners',
    body: 'Every cleaner is screened and verified before they can take a job, and rated by the households they clean for.',
  },
  {
    title: 'Smart local matching',
    body: 'We match on location, availability and what you actually need — not whoever happens to be top of a list.',
  },
  {
    title: 'Flexible booking',
    body: 'Book a one-off, set up weekly visits, or get a deep clean before you move. You choose.',
  },
  {
    title: 'Fair pay for cleaners',
    body: 'Cleaners set their own prices and choose their own jobs. Good work, fairly paid, builds lasting relationships.',
  },
];

const year = new Date().getFullYear();
---

<Layout>
  <header class="sticky top-0 z-10 border-b border-hairline/80 bg-surface/85 backdrop-blur">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6" aria-label="Main">
      <a href="/" class="flex items-center gap-2 font-semibold text-ink">
        <img src="/logo.png" alt="" width="32" height="32" class="size-8 rounded-lg" />
        <span class="text-lg tracking-tight">Dusty</span>
      </a>
      <div class="flex items-center gap-1 sm:gap-2">
        <a href="#how" class="hidden rounded-full px-3 py-2 text-sm text-muted hover:text-ink sm:inline-block">How it works</a>
        <a href="#cleaners" class="hidden rounded-full px-3 py-2 text-sm text-muted hover:text-ink sm:inline-block">For cleaners</a>
        <a href={links.customerWaitlist} class="rounded-full bg-primary px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-primary-pressed">
          Join the waitlist
        </a>
      </div>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div aria-hidden="true" class="pointer-events-none absolute -top-40 left-1/2 h-[36rem] w-[60rem] -translate-x-1/2 rounded-full bg-primary-light/70 blur-3xl"></div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 pt-14 pb-20 sm:px-6 lg:grid-cols-[1.1fr_1fr] lg:pt-24 lg:pb-28">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full bg-card px-3 py-1 text-sm font-medium text-primary-deep shadow-ambient">
            <span class="size-2 rounded-full bg-success" aria-hidden="true"></span>
            Now accepting early access sign-ups
          </p>
          <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
            Trusted home cleaning, <span class="text-primary">matched to you</span>
          </h1>
          <p class="mt-5 max-w-xl text-lg text-muted">
            Dusty connects busy UK households with vetted, local cleaners. Tell us what you need and we'll find the right person for your home — no endless scrolling, no chasing quotes.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={links.customerWaitlist} class="rounded-full bg-primary px-6 py-3.5 text-center font-semibold text-white shadow-ambient transition-colors hover:bg-primary-pressed">
              Join the waitlist
            </a>
            <a href={links.whatsapp} class="rounded-full bg-primary-light px-6 py-3.5 text-center font-semibold text-primary-deep transition-colors hover:bg-surface-container">
              Book a clean on WhatsApp
            </a>
          </div>
          <p class="mt-4 text-sm text-muted">
            Are you a cleaner? <a href={links.cleanerSignup} class="font-medium text-primary underline-offset-4 hover:underline">Join our cleaner network</a>
          </p>
        </div>

        <!-- The app's hero moment: one recommendation, with its reasons. -->
        <div class="mx-auto w-full max-w-sm" aria-hidden="true">
          <div class="rounded-3xl bg-card p-5 shadow-ambient">
            <p class="text-xs font-semibold tracking-wide text-primary uppercase">Dusty's pick for you</p>
            <div class="mt-4 flex items-center gap-3">
              <div class="flex size-12 items-center justify-center rounded-full bg-primary-light text-lg font-semibold text-primary-deep">A</div>
              <div>
                <p class="font-semibold">Amara</p>
                <p class="text-sm text-muted">★ 4.9 · 62 cleans · 1.2 miles away</p>
              </div>
              <span class="ml-auto rounded-full bg-primary-light px-2.5 py-1 text-xs font-medium text-primary-deep">Verified</span>
            </div>
            <ul class="mt-5 space-y-2 text-sm text-muted">
              <li class="flex gap-2"><span class="text-primary">✓</span> Free on Saturday morning</li>
              <li class="flex gap-2"><span class="text-primary">✓</span> Great with pets — you have a dog</li>
              <li class="flex gap-2"><span class="text-primary">✓</span> Within your £60 budget</li>
            </ul>
            <div class="mt-5 rounded-full bg-primary py-3 text-center text-sm font-semibold text-white">Request Amara</div>
          </div>
          <p class="mt-3 text-center text-xs text-muted">Example of a match in the Dusty app</p>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="border-y border-hairline bg-card">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-y-8 px-4 py-10 sm:px-6 md:grid-cols-4">
        {stats.map((s) => (
          <div class="flex flex-col-reverse text-center">
            <dt class="text-sm text-muted">{s.label}</dt>
            <dd class="text-3xl font-bold tracking-tight text-primary-deep">{s.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- How it works -->
    <section id="how" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6">
      <p class="text-sm font-semibold tracking-wide text-primary uppercase">How it works</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">A spotless home in four steps</h2>
      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((step, i) => (
          <li class="rounded-2xl bg-card p-6 shadow-ambient">
            <span class="flex size-9 items-center justify-center rounded-full bg-primary-light font-semibold text-primary-deep">{i + 1}</span>
            <h3 class="mt-4 font-semibold">{step.title}</h3>
            <p class="mt-1.5 text-sm text-muted">{step.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Why Dusty -->
    <section class="bg-surface-container/60">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
        <p class="text-sm font-semibold tracking-wide text-primary uppercase">Why Dusty</p>
        <h2 class="mt-2 max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">Finding a cleaner shouldn't be a chore in itself</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {reasons.map((r) => (
            <div class="rounded-2xl bg-card p-6 shadow-ambient">
              <h3 class="font-semibold">{r.title}</h3>
              <p class="mt-1.5 text-muted">{r.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- App -->
    <section id="app" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6">
      <div class="rounded-3xl bg-primary-deep px-6 py-14 text-center text-white sm:px-12">
        <p class="text-sm font-semibold tracking-wide text-primary-light uppercase">{appLive ? 'Out now' : 'Coming soon'}</p>
        <h2 class="mx-auto mt-2 max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">The Dusty app for iPhone and Android</h2>
        <p class="mx-auto mt-4 max-w-xl text-white/80">
          Book, reschedule and message your cleaner in one place. Join the early access list and be among the first to try it.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          {[
            { label: 'App Store', href: links.appStore },
            { label: 'Google Play', href: links.googlePlay },
          ].map((store) =>
            store.href ? (
              <a href={store.href} class="w-full rounded-full bg-white px-6 py-3 font-semibold text-ink sm:w-auto">{store.label}</a>
            ) : (
              <span class="w-full rounded-full border border-white/30 px-6 py-3 font-medium text-white/70 sm:w-auto">{store.label} · soon</span>
            ),
          )}
        </div>
        {!appLive && (
          <a href={links.customerWaitlist} class="mt-6 inline-block rounded-full bg-white px-6 py-3.5 font-semibold text-primary-deep transition-colors hover:bg-primary-light">
            Get early access
          </a>
        )}
      </div>
    </section>

    <!-- Cleaners -->
    <section id="cleaners" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-20 sm:px-6">
      <div class="grid items-center gap-8 rounded-3xl bg-card p-8 shadow-ambient sm:p-12 md:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="text-sm font-semibold tracking-wide text-primary uppercase">For cleaners</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight">Your prices. Your hours. Local jobs.</h2>
          <p class="mt-3 text-muted">
            Join our local cleaner network. Set your own rates, choose the jobs you want, and get matched with households near you.
          </p>
        </div>
        <a href={links.cleanerSignup} class="rounded-full bg-primary px-6 py-3.5 text-center font-semibold text-white transition-colors hover:bg-primary-pressed">
          Join as a cleaner
        </a>
      </div>
    </section>
  </main>

  <footer id="contact" class="border-t border-hairline bg-card">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
      <div>
        <a href="/" class="flex items-center gap-2 font-semibold">
          <img src="/logo.png" alt="" width="32" height="32" class="size-8 rounded-lg" />
          <span class="text-lg tracking-tight">Dusty</span>
        </a>
        <p class="mt-3 text-sm text-muted">Trusted home cleaning, matched to you.</p>
      </div>
      <div>
        <h2 class="text-sm font-semibold">Contact us</h2>
        <ul class="mt-3 space-y-2 text-sm text-muted">
          <li><a href={`mailto:${contact.email}`} class="hover:text-ink">{contact.email}</a></li>
          <li><a href={contact.phoneHref} class="hover:text-ink">{contact.phoneDisplay}</a></li>
          <li><a href={links.whatsapp} class="hover:text-ink">WhatsApp</a></li>
        </ul>
      </div>
      <div>
        <h2 class="text-sm font-semibold">Follow us</h2>
        <ul class="mt-3 space-y-2 text-sm text-muted">
          <li><a href={links.instagram} class="hover:text-ink">Instagram {contact.instagramHandle}</a></li>
        </ul>
      </div>
    </div>
    <p class="border-t border-hairline py-6 text-center text-xs text-muted">© {year} Dusty. All rights reserved.</p>
  </footer>
</Layout>
