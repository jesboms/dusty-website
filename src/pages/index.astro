    </section>

    <!-- Contact Section / Footer -->
    <footer id="contact" class="scroll-mt-16 px-4 sm:px-6 lg:px-8 py-16 md:py-24 bg-gray-800 text-white">
      <div class="max-w-6xl mx-auto">
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
          <div>
            <div class="flex items-center gap-2.5 mb-4">
              <img src="/logo.png" alt="" width="40" height="40" class="h-10 w-10 rounded-lg" />
              <span class="text-2xl font-extrabold tracking-tight text-white">Dusty</span>
            </div>
            <p class="text-gray-400 leading-relaxed">Trusted home cleaning, matched to you.</p>
          </div>

          <div>
            <h3 class="font-bold text-sm uppercase tracking-wider text-gray-400 mb-5">Quick Links</h3>
