        <div class="border-t border-gray-800 pt-8">
          <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
            <p class="text-gray-500 text-sm">&copy; {year} Dusty. All rights reserved.</p>
            <a
              href={links.customerWaitlist}
              target="_blank"
              rel="noopener noreferrer"
              class={`inline-flex items-center justify-center gap-2 ${gradientBtn} font-semibold py-2.5 px-6 rounded-lg shadow-md shadow-violet-900/30 transition-all duration-200 text-sm`}
            >
              <Sparkles size={14} />
              Join Early Access
