---
// The Dusty lockup: the broom mark and the "Dusty" wordmark, as one inline
// SVG so it takes its colours from Tailwind text classes. The source of
// truth is brand/svg/dusty-lockup.svg in the app repo (jesboms/dusty); the
// wordmark is Inter Display SemiBold outlined, so no font needs loading.
interface Props {
  /** Tailwind text colour for the mark, e.g. "text-violet-600". */
  mark?: string;
  /** Tailwind text colour for the wordmark, e.g. "text-gray-900". */
  word?: string;
  /** Height classes for the whole lockup. */
  class?: string;
}
const { mark = 'text-violet-600', word = 'text-gray-900', class: className = 'h-8' } = Astro.props;
---

