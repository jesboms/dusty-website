  <g transform="translate(0 0) scale(10.04) translate(-6 -1.39)"><path class={mark} fill="currentColor" d="M30.34 48.31A5 5 0 0 1 37.03 47.3L53.26 58.24A5 5 0 0 1 55.27 61.03L62.57 86.92A4 4 0 0 1 58.72 92L11.25 92A4 4 0 0 1 7.39 86.94L9.41 79.59A40 40 0 0 1 16.83 65.09ZM53.01 52.05L79.3 13.08A7.5 7.5 0 0 0 66.86 4.7L40.58 43.66A7.5 7.5 0 0 0 53.01 52.05ZM75.5 85a6.5 6.5 0 1 0 13 0a6.5 6.5 0 1 0 -13 0Z" /></g>
